<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenUnbloat v1.0" Height="800" Width="1080"
        MinHeight="620" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#0D1017" Foreground="#F1F5F9"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontSize="13">
    
    <Window.Resources>
        <!-- Spójny styl przycisków pomocniczych (Nagłówek, Zakładki, Filtry) -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1D2333"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#2D384E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#263045"/>
                                <Setter Property="BorderBrush" Value="#60A5FA"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#161B27"/>
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dedykowany, spójny styl przycisków akcji w zakładce Konserwacja i Naprawa -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E2536"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#313D57"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="actBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,4,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#29334B"/>
                                <Setter Property="BorderBrush" Value="#60A5FA"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#161B27"/>
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Główny przycisk akcji (Vibrant Azure na dole) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,4,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl Kafelka / Karty w spójnej palecie Obsidian Slate -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#151924"/>
            <Setter Property="BorderBrush" Value="#22293A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Nowoczesny Dark Styl dla zakładek TabItem -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="#131722"/>
            <Setter Property="BorderBrush" Value="#1F2636"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1A202F"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2D374D"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#181E2B"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,2,1,0"/>
                                <Setter Property="Foreground" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl TabControl ze stałym jednym rzędem i poziomym przewijaniem -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#0D1017"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="#1C2333" BorderThickness="0,0,0,1">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                                    <StackPanel Orientation="Horizontal" IsItemsHost="True" Background="Transparent"/>
                                </ScrollViewer>
                            </Border>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl dla nowoczesnego pola wyszukiwania z ikoną i tekstem zastępczym (Placeholder) -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#151924"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#242C3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid Margin="10,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.55"/>
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center"/>
                                <TextBlock x:Name="watermark" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="#64748B" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3D4960"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="border" Property="Background" Value="#181E2B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nowoczesny styl CheckBox w spójnej palecie Obsidian Slate i Azure -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Pole wyboru (Box) -->
                            <Border x:Name="chkBox"
                                    Grid.Column="0"
                                    Width="18" Height="18"
                                    CornerRadius="4"
                                    Background="#181E2B"
                                    BorderBrush="#334155"
                                    BorderThickness="1.5"
                                    SnapsToDevicePixels="True">
                                <!-- Wektorowy znacznik wyboru (Checkmark) -->
                                <Path x:Name="chkMark"
                                      Data="M 3,8.5 L 6.5,12 L 13.5,4.5"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            
                            <!-- Etykieta checkboxa -->
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chkBox" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="chkBox" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="chkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="chkBox" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter TargetName="chkBox" Property="Background" Value="#222C3E"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="chkBox" Property="Background" Value="#3B82F6"/>
                                <Setter TargetName="chkBox" Property="BorderBrush" Value="#60A5FA"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl dla Thumb paska przewijania (pionowy) -->
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#283348"
                                CornerRadius="4"
                                Margin="2,0,2,0"
                                SnapsToDevicePixels="True"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3B4B69"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter Property="Background" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl dla Thumb paska przewijania (poziomy) -->
        <Style x:Key="HorizontalScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#283348"
                                CornerRadius="4"
                                Margin="0,2,0,2"
                                SnapsToDevicePixels="True"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3B4B69"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter Property="Background" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Przycisk szyny paska przewijania (niewidoczne powiększenie bez archaicznych strzałek) -->
        <Style x:Key="ScrollBarTrackButtonStyle" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dedykowany, ciemny i minimalistyczny styl ScrollBar dla całego okna -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBarTrackButtonStyle}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBarTrackButtonStyle}"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollBarTrackButtonStyle}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource HorizontalScrollBarThumbStyle}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollBarTrackButtonStyle}"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Styl przycisku czyszczenia wyszukiwania (X) -->
        <Style x:Key="ClearSearchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Nowoczesny styl dla dymków podpowiedzi (ToolTip) w spójnym ciemnym motywie -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#181E2B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Nowoczesny płaski styl dla paska postępu (ProgressBar) -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="3"/>
            <Setter Property="Background" Value="#121622"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- NAGŁÓWEK (Czysty, minimalistyczny z aksamitnym tłem) -->
        <Border Grid.Row="0" Background="#121622" BorderBrush="#1C2333" BorderThickness="0,0,0,1" Padding="20,16">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡️ OPENUNBLOAT" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0 • Edycja Stabilna" FontSize="11" Foreground="#60A5FA" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Przejrzyste i w 100% odwracalne narzędzie do optymalizacji systemu" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>

                <Border DockPanel.Dock="Right" Background="#221C14" BorderBrush="#553A17" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center" Margin="12,0,0,0"
                        ToolTip="Tryb symulacji (Dry-Run): Pozwala bezpiecznie przetestować operacje bez wprowadzania realnych zmian w rejestrze, plikach ani usługach systemu Windows. Wszystkie zaplanowane akcje zostaną wypisane w Dzienniku Zdarzeń jako bezpieczny podgląd.">
                    <CheckBox x:Name="chkDryRun" Content="Tryb symulacji (Dry-Run)" Foreground="#FBBF24" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Cursor="Hand"
                              ToolTip="Tryb symulacji (Dry-Run): Pozwala bezpiecznie przetestować operacje bez wprowadzania realnych zmian w rejestrze, plikach ani usługach systemu Windows. Wszystkie zaplanowane akcje zostaną wypisane w Dzienniku Zdarzeń jako bezpieczny podgląd."/>
                </Border>
            </DockPanel>
        </Border>

        <!-- GŁÓWNA ZAWARTOŚĆ (ZAKŁADKI) -->
        <TabControl x:Name="mainTabControl" Grid.Row="1" Margin="16,12,16,12">
            
            <!-- ZAKŁADKA 1: TWEAKI I PRYWATNOŚĆ -->
            <TabItem x:Name="tabTweaks" Header="  🛡️ Optymalizacje &amp; Prywatność  ">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- RZĄD 0: Estetyczny baner profili szybkiej konfiguracji -->
                    <Border Grid.Row="0" Background="#141926" BorderBrush="#222B3D" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="⚡ Szybkie profile:" FontSize="12.5" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                <TextBlock Text="(kliknij, aby automatycznie zaznaczyć zestaw)" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="btnPresetRecommended" Content="🟢 Profil Zalecany" Style="{StaticResource HeaderButtonStyle}" Margin="0,2,8,2" Padding="16,8"/>
                                <Button x:Name="btnPresetGaming" Content="⚡ Profil Gracza" Style="{StaticResource HeaderButtonStyle}" Margin="0,2,8,2" Padding="16,8"/>
                                <Button x:Name="btnPresetPrivacy" Content="🛡️ Profil Prywatność" Style="{StaticResource HeaderButtonStyle}" Margin="0,2,8,2" Padding="16,8"/>
                                <Button x:Name="btnPresetRevert" Content="🔄 Przywróć Domyślne" Style="{StaticResource HeaderButtonStyle}" Margin="0,2,0,2" Padding="16,8"/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <!-- RZĄD 1: Pasek wyszukiwania i zaznaczania -->
                    <DockPanel Grid.Row="1" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Wybierz optymalizacje:" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <Grid Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBox x:Name="txtSearchTweaks" Style="{StaticResource SearchTextBoxStyle}" Tag="Wpisz, aby szukać tweaków..." Width="240" Height="30" Padding="8,4,26,4" ToolTip="Filtruj tweaki po nazwie lub opisie (Ctrl+F)..."/>
                                <Button x:Name="btnClearSearchTweaks" Style="{StaticResource ClearSearchButtonStyle}" Content="✕" Width="20" Height="20" HorizontalAlignment="Right" Margin="0,0,6,0" Visibility="Collapsed" ToolTip="Wyczyść filtr (Esc)"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btnSelectAllTweaks" Content="Zaznacz wszystko" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,8,0" Padding="14,6" MinHeight="30"/>
                            <Button x:Name="btnUnselectAllTweaks" Content="Odznacz wszystko" Style="{StaticResource HeaderButtonStyle}" Padding="14,6" MinHeight="30"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- RZĄD 2: Lista kafelków -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="panelTweaksList" Margin="0,0,12,0">
                            <!-- Dynamicznie generowane kafelki z bazy tweaks.json -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ZAKŁADKA 2: APLIKACJE BLOATWARE -->
            <TabItem x:Name="tabApps" Header="  📦 Aplikacje Bloatware  ">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Katalog aplikacji:" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <Grid Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBox x:Name="txtSearchApps" Style="{StaticResource SearchTextBoxStyle}" Tag="Wpisz, aby szukać aplikacji..." Width="230" Height="30" Padding="8,4,26,4" ToolTip="Filtruj aplikacje po nazwie (Ctrl+F)..."/>
                                <Button x:Name="btnClearSearchApps" Style="{StaticResource ClearSearchButtonStyle}" Content="✕" Width="20" Height="20" HorizontalAlignment="Right" Margin="0,0,6,0" Visibility="Collapsed" ToolTip="Wyczyść filtr (Esc)"/>
                            </Grid>
                            <CheckBox x:Name="chkOnlyInstalledApps" Content="Tylko zainstalowane" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" Cursor="Hand" IsChecked="True" ToolTip="Pokaż tylko aplikacje faktycznie zainstalowane w Twoim systemie"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btnScanApps" Content="🔄 Odśwież stan" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,8,0" Padding="14,6" MinHeight="30"/>
                            <Button x:Name="btnSelectSafeApps" Content="Zaznacz bezpieczne" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,8,0" Padding="14,6" MinHeight="30"/>
                            <Button x:Name="btnUnselectApps" Content="Odznacz wszystko" Style="{StaticResource HeaderButtonStyle}" Padding="14,6" MinHeight="30"/>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="panelAppsList" Margin="0,0,12,0">
                            <!-- Dynamicznie generowane aplikacje bloatware -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ZAKŁADKA 3: INSTALATOR WINGET -->
            <TabItem x:Name="tabSoftware" Header="  💻 Instalator WinGet  ">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Wybierz programy:" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <Grid Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBox x:Name="txtSearchSoftware" Style="{StaticResource SearchTextBoxStyle}" Tag="Wpisz nazwę (np. Brave, 7-Zip)..." Width="240" Height="30" Padding="8,4,26,4" ToolTip="Filtruj programy po nazwie (Ctrl+F)..."/>
                                <Button x:Name="btnClearSearchSoftware" Style="{StaticResource ClearSearchButtonStyle}" Content="✕" Width="20" Height="20" HorizontalAlignment="Right" Margin="0,0,6,0" Visibility="Collapsed" ToolTip="Wyczyść filtr (Esc)"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btnSelectRecSoftware" Content="Zaznacz zalecane" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,8,0" Padding="14,6" MinHeight="30"/>
                            <Button x:Name="btnUnselectSoftware" Content="Odznacz wszystko" Style="{StaticResource HeaderButtonStyle}" Padding="14,6" MinHeight="30"/>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="panelSoftwareList" Margin="0,0,12,0">
                            <!-- Dynamicznie generowana lista z software.json -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ZAKŁADKA 4: KONSERWACJA -->
            <TabItem x:Name="tabMaintenance" Header="  🛠️ Konserwacja &amp; Naprawa  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Narzędzia diagnostyczne i optymalizacji jednym kliknięciem:" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,14"/>

                        <!-- Kafelek 1: Czyszczenie dysku -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🧹" FontSize="26" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                                    <TextBlock Text="Czyszczenie plików tymczasowych i pamięci aktualizacji" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Usuwa pliki cache, Temp użytkownika i Windows oraz stare pliki instalacyjne Windows Update." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="btnActionCleanup" Grid.Column="2" Content="Wyczyść Dysk" Style="{StaticResource ActionButtonStyle}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Kafelek 2: Reset sieci -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🌐" FontSize="26" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                                    <TextBlock Text="Reset stosu sieciowego i czyszczenie DNS" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Naprawia problemy z połączeniem, czyści cache DNS i resetuje protokół Winsock/IP." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="btnActionResetNetwork" Grid.Column="2" Content="Resetuj Sieć" Style="{StaticResource ActionButtonStyle}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Kafelek 3: Plan Ultimate Performance -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚡" FontSize="26" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                                    <TextBlock Text="Plan zasilania 'Najwyższa wydajność' (Ultimate Performance)" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Odblokowuje ukryty plan zasilania eliminujący mikro-uśpienia rdzeni procesora." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="btnActionUltimatePower" Grid.Column="2" Content="Aktywuj Plan" Style="{StaticResource ActionButtonStyle}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Kafelek 4: SFC & DISM -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🩺" FontSize="26" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                                    <TextBlock Text="Diagnostyka i naprawa integralności systemu (SFC &amp; DISM)" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Skanuje pliki systemowe w poszukiwaniu uszkodzeń i naprawia obraz Windowsa." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="btnActionRepair" Grid.Column="2" Content="Uruchom Naprawę" Style="{StaticResource ActionButtonStyle}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Kafelek 5: Windows Update Reset -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔄" FontSize="26" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                                    <TextBlock Text="Naprawa i czyszczenie pamięci podręcznej Windows Update" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Zatrzymuje usługi aktualizacji, usuwa uszkodzone pliki pobierania i restartuje składniki." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="btnActionResetUpdate" Grid.Column="2" Content="Wyczyść Update" Style="{StaticResource ActionButtonStyle}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Kafelek 6: Naprawa WinGet -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📦" FontSize="26" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                                    <TextBlock Text="Weryfikacja i naprawa repozytoriów WinGet" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Resetuje oficjalne źródła pakietów winget i naprawia rejestrację instalatora aplikacji." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="btnActionRepairWinget" Grid.Column="2" Content="Napraw WinGet" Style="{StaticResource ActionButtonStyle}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Kafelek 7: Eksport kopii rejestru .reg -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="💾" FontSize="26" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                                    <TextBlock Text="Eksport pełnej kopii rejestru (.reg backup)" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Tworzy plik kopii zapasowej kluczowych gałęzi na Pulpicie do natychmiastowego przywrócenia." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="btnActionBackupRegistry" Grid.Column="2" Content="Utwórz Kopię .reg" Style="{StaticResource ActionButtonStyle}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Kafelek 8: Szybka konfiguracja Bezpiecznego DNS -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🌐" FontSize="26" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                                    <TextBlock Text="Konfiguracja bezpiecznego i szybkiego DNS (Prywatność i Bezpieczeństwo)" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Ustawia zaufany resolver DNS (Cloudflare 1.1.1.1 lub filtrujący złośliwe domeny Quad9 9.9.9.9) albo przywraca DHCP." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="btnDnsCloudflare" Content="⚡ Cloudflare" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,6,0" Padding="12,8" ToolTip="Ustaw ultra-szybki Cloudflare DNS (1.1.1.1 / 1.0.0.1)"/>
                                    <Button x:Name="btnDnsQuad9" Content="🛡️ Quad9" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,6,0" Padding="12,8" ToolTip="Ustaw bezpieczny Quad9 DNS blokujący złośliwe domeny i malware (9.9.9.9)"/>
                                    <Button x:Name="btnDnsDhcp" Content="🔄 Domyślny DHCP" Style="{StaticResource HeaderButtonStyle}" Padding="12,8" ToolTip="Przywróć automatyczne pobieranie adresów DNS od routera / dostawcy (DHCP)"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ZAKŁADKA 5: DZIENNIK ZDARZEŃ -->
            <TabItem x:Name="tabLogs" Header="  📋 Dziennik Zdarzeń  ">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="txtLogConsole" Grid.Row="0" Background="#0A0D12" Foreground="#7DD3FC"
                             FontFamily="Consolas, monospace" FontSize="12" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="Wrap" BorderBrush="#1C2333" BorderThickness="1" Padding="14"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="btnCopyLog" Content="📋 Kopiuj do schowka" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,8,0" Padding="16,7" MinHeight="32"/>
                        <Button x:Name="btnSaveLog" Content="💾 Zapisz do pliku" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,8,0" Padding="16,7" MinHeight="32"/>
                        <Button x:Name="btnClearLog" Content="Wyczyść dziennik" Style="{StaticResource HeaderButtonStyle}" Padding="16,7" MinHeight="32"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- DOLNY PASEK AKCJI -->
        <Grid Grid.Row="2">
            <!-- Pasek aktywności (Marquee ProgressBar) sygnalizujący pracę w tle -->
            <ProgressBar x:Name="pbProgress" Height="3" VerticalAlignment="Top"
                         IsIndeterminate="False" Visibility="Collapsed"
                         Background="#121622" Foreground="#38BDF8" BorderThickness="0"
                         Panel.ZIndex="10"/>

            <Border Background="#121622" BorderBrush="#1C2333" BorderThickness="0,1,0,0" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="badgeSelectionCount" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="lblSelectionCount" Text="Zaznaczono: 0" FontSize="11.5" FontWeight="SemiBold" Foreground="#38BDF8"/>
                            </Border>
                            <TextBlock x:Name="lblStatus" Text="Gotowy do działania. Wybierz opcje i kliknij przycisk akcji." FontSize="12" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnCreateRestorePoint" Content="🛡️ Punkt Przywracania" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,12,0" Padding="18,10" MinHeight="38"/>
                        <Button x:Name="btnApplyAllSelected" Content="⚡ Zastosuj wybrane optymalizacje (0)" Style="{StaticResource PrimaryButtonStyle}" Padding="24,10" MinHeight="38" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
